# ===== LLM 网关（OpenAI 兼容，可替换为任意同构服务） =====
LLM_BASE_URL=https://tokenrhythm.studio/v1
LLM_API_KEY=sk_tr_xxx
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ===== RAG Embedding（本地 BGE 中文模型，无需外部 Embedding API） =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
TOP_K=4
SCORE_THRESHOLD=0.35
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ===== 国内网络 / 受限环境：HuggingFace 镜像 =====
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
